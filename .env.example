# ─── Data Source ───
# Option A: Google Sheets API (recommended)
GOOGLE_SHEETS_MODE=false
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-from-the-url
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Option B: Local xlsx file (fallback) — File → Download → Microsoft Excel from the plan
EVENTING_PLAN_PATH=./data/cr-eventing-plan.xlsx

# ─── Links back to the plan (keep these local; they're not committed) ───
# Built from GOOGLE_SPREADSHEET_ID when unset
EVENTING_PLAN_URL=https://docs.google.com/spreadsheets/d/your-spreadsheet-id/edit
# xlsx mode only: tab IDs for row-level links (the number after #gid= with each tab open)
# EVENTING_PLAN_TAB_GIDS=Track:123,Identify:456,Page:0,Screen:789

# ─── Jira (for --live mode) ───
JIRA_BASE_URL=https://jira.your-company.com
JIRA_PROJECT_KEY=TRACK
JIRA_EPIC_KEY=TRACK-123

# Jira Data Center/Server: personal access token (your Jira profile → Personal Access Tokens)
JIRA_PAT=your-personal-access-token
# Jira Cloud instead: email + API token (https://id.atlassian.com/manage-profile/security/api-tokens)
# JIRA_EMAIL=your-email@example.com
# JIRA_API_TOKEN=your-jira-api-token

# Optional
# JIRA_ISSUE_TYPE=Story
# JIRA_EPIC_FIELD=customfield_10008   # detected automatically; set only to override
# JIRA_EXTRA_LABELS=q4-launch,web-team
