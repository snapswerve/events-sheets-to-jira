{
  "name": "events-sheets-to-jira",
  "version": "1.0.0",
  "description": "Reads a Google Sheets event tracking plan and creates Jira tickets under an Epic.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dry-run": "node src/index.js",
    "export": "node src/index.js --export",
    "live": "node src/index.js --live",
    "sample": "node examples/build-sample-plan.js && GOOGLE_SHEETS_MODE=false EVENTING_PLAN_PATH=examples/sample-eventing-plan.xlsx node src/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0",
    "mammoth": "^1.12.0",
    "node-fetch": "^3.3.2",
    "xlsx": "^0.18.5"
  }
}
